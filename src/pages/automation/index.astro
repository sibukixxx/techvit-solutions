---
import { getCollection } from "astro:content";
import Cta from "@/components/Cta.astro";
import Card from "@/components/ui/Card.astro";
import Section from "@/components/ui/Section.astro";
import Base from "@/layouts/Base.astro";

const automations = (
  await getCollection("automation", (e) => e.data.published)
).sort((a, b) => a.data.order - b.data.order);
---

<Base
  title="業務自動化メニュー"
  description="PDF・文書、Excel・事務、メール、営業、バックオフィス、社内AI検索。AIで自動化できる業務の一覧です。"
>
  <Section
    title="業務自動化メニュー"
    lead="毎月くり返している手作業は、ほとんどが自動化の候補です。心当たりのある業務からご覧ください。"
  >
    <div class="grid gap-6 sm:grid-cols-2">
      {
        automations.map((entry) => (
          <Card href={`/automation/${entry.id}/`}>
            <h2 class="text-xl font-bold text-slate-900">{entry.data.title}</h2>
            <p class="mt-2 text-sm text-slate-600">{entry.data.lead}</p>
            <ul class="mt-4 space-y-1">
              {entry.data.pains.slice(0, 2).map((pain) => (
                <li class="text-sm text-slate-500">・{pain}</li>
              ))}
            </ul>
            <p class="mt-4 text-sm font-bold text-brand-600">詳しく見る →</p>
          </Card>
        ))
      }
    </div>
  </Section>
  <Cta />
</Base>
