---
import { getCollection } from "astro:content";
import Cta from "@/components/Cta.astro";
import ModelCaseNote from "@/components/ModelCaseNote.astro";
import Card from "@/components/ui/Card.astro";
import Section from "@/components/ui/Section.astro";
import Base from "@/layouts/Base.astro";
import { formatMinutes, reductionRate, savedMinutes } from "@/lib/reduction";
import { AUTOMATION_LABELS, INDUSTRY_LABELS } from "@/lib/site";

const cases = (await getCollection("cases", (e) => e.data.published)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
---

<Base
  title="モデルケース"
  description="PDF検索・Excel転記・メール処理などの自動化による削減時間を、Before / After 形式のモデルケースで紹介します。"
>
  <Section
    title="削減時間のモデルケース"
    lead="どんな業務が、どれくらい軽くなるのか。Before / After と削減時間でご覧ください。"
  >
    <div class="mb-8">
      <ModelCaseNote />
    </div>
    <div class="grid gap-6 lg:grid-cols-3 sm:grid-cols-2">
      {
        cases.map((entry) => {
          const saved = savedMinutes(entry.data.before, entry.data.after);
          const rate = reductionRate(entry.data.before, entry.data.after);
          return (
            <Card href={`/cases/${entry.id}/`}>
              <div class="flex flex-wrap gap-2 text-xs">
                <span class="rounded-full bg-brand-100 px-2.5 py-0.5 font-bold text-brand-800">
                  {INDUSTRY_LABELS[entry.data.industry]}
                </span>
                {entry.data.automation.map((a) => (
                  <span class="rounded-full bg-slate-100 px-2.5 py-0.5 text-slate-600">
                    {AUTOMATION_LABELS[a]}
                  </span>
                ))}
              </div>
              <h2 class="mt-3 font-bold text-slate-900">{entry.data.title}</h2>
              <p class="mt-4 text-sm text-slate-600">
                1回あたり
                <span class="mx-1 text-2xl font-bold text-brand-700">
                  −{formatMinutes(saved)}
                </span>
                （{rate}%削減）
              </p>
            </Card>
          );
        })
      }
    </div>
  </Section>
  <Cta />
</Base>
