---
import Breadcrumb from "@/components/Breadcrumb.astro";
import Cta from "@/components/Cta.astro";
import Card from "@/components/ui/Card.astro";
import Section from "@/components/ui/Section.astro";
import Base from "@/layouts/Base.astro";
import { plans as plansByLocale } from "@/lib/plans";

const plans = plansByLocale("en");
---

<Base
  title="Pricing"
  description="AI workflow assessment from $250, PoC from $850, full build from $2,600, ongoing support from $450/mo. A 4-step pricing model that lets you test before you commit. Small single-purpose tools and existing-tool upgrades welcome."
  locale="en"
  alternates={{ ja: "/pricing/", en: "/en/pricing/" }}
>
  <Breadcrumb items={[{ name: "Pricing" }]} locale="en" />
  <Section
    title="Pricing"
    lead="We don't recommend jumping straight to a full build. Assessment → Pilot → Full build → Ongoing support: each step's price and deliverable is on the table upfront, and you decide whether to continue after each one. Every service follows the same four steps."
  >
    <div class="grid gap-6 md:grid-cols-2 xl:grid-cols-4">
      {
        plans.map((plan) => (
          <Card class={plan.recurring ? "border-brand-200 bg-brand-50/40" : ""}>
            <p class="text-sm font-bold text-brand-600">{plan.step}</p>
            <h2 class="mt-1 text-xl font-bold text-slate-900">{plan.name}</h2>
            <p class="mt-2 text-3xl font-bold text-slate-900">{plan.price}</p>
            <p class="mt-1 text-sm text-slate-500">Typical timeline: {plan.period}</p>
            <ul class="mt-4 space-y-2 border-t border-slate-100 pt-4">
              {plan.items.map((item) => (
                <li class="text-sm text-slate-700">✓ {item}</li>
              ))}
            </ul>
            <p class="mt-4 text-xs text-slate-500">{plan.note}</p>
          </Card>
        ))
      }
    </div>

    <div class="mt-10 grid gap-6 md:grid-cols-2">
      <div class="rounded-xl border border-slate-200 bg-slate-50 p-6">
        <h2 class="text-lg font-bold text-slate-900">Small single-purpose tools</h2>
        <p class="mt-2 text-sm text-slate-600">
          One problem, one screen, built for your team in 1–2 weeks: PDF diff, FAQ generation,
          outreach email drafting, quote generation, and the like. Quoted individually once we
          hear the problem.
        </p>
        <a href="/en/services/#tools" class="mt-3 inline-block text-sm font-bold text-brand-600 hover:underline">
          See examples →
        </a>
      </div>
      <div class="rounded-xl border border-slate-200 bg-slate-50 p-6">
        <h2 class="text-lg font-bold text-slate-900">Existing tool upgrades</h2>
        <p class="mt-2 text-sm text-slate-600">
          We also take on requests like “the macro/script someone built for us stopped working” or
          “we want to add AI to a tool we already have.” We'll review it and quote separately.
        </p>
      </div>
    </div>
  </Section>
  <Cta locale="en" />
</Base>
