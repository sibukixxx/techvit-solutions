---
import Breadcrumb from "@/components/Breadcrumb.astro";
import Cta from "@/components/Cta.astro";
import Card from "@/components/ui/Card.astro";
import Section from "@/components/ui/Section.astro";
import Base from "@/layouts/Base.astro";

const plans = [
  {
    step: "STEP 1",
    name: "Automation Assessment",
    price: "¥30,000–50,000",
    period: "1–2 weeks",
    items: [
      "Interview and map out your current manual work",
      "Separate what can be automated from what can't",
      "A report estimating time saved and cost",
    ],
    note: "You're welcome to take just the report and use it for internal discussion.",
  },
  {
    step: "STEP 2",
    name: "PoC (Pilot)",
    price: "¥100,000–300,000",
    period: "2 weeks – 1 month",
    items: [
      "Pick the one task with the biggest payoff",
      "Build a working prototype against real data",
      "Measure actual time saved and quote the full build",
    ],
    note: "Learning “it saves less than we thought” is a valid PoC outcome too — stopping here is fine.",
  },
  {
    step: "STEP 3",
    name: "Full Build",
    price: "From ¥300,000",
    period: "1–3 months",
    items: [
      "Turn the validated PoC into something used daily",
      "Includes error handling, review flow, and handoff docs",
      "One month of post-launch tuning included",
    ],
    note: "Varies with scope. Quoted as a fixed price based on the PoC results.",
  },
];
---

<Base
  title="Pricing"
  description="Automation assessment from ¥30,000, PoC from ¥100,000, full build from ¥300,000. A 3-step pricing model that lets you test before you commit. Existing-tool upgrades welcome."
  locale="en"
  alternates={{ ja: "/pricing/", en: "/en/pricing/" }}
>
  <Breadcrumb items={[{ name: "Pricing" }]} locale="en" />
  <Section
    title="Pricing"
    lead="We don't recommend jumping straight to a full build. Each step's price and deliverable is on the table upfront, and you decide whether to continue after each one."
  >
    <div class="grid gap-6 lg:grid-cols-3">
      {
        plans.map((plan) => (
          <Card>
            <p class="text-sm font-bold text-brand-600">{plan.step}</p>
            <h2 class="mt-1 text-xl font-bold text-slate-900">{plan.name}</h2>
            <p class="mt-2 text-3xl font-bold text-slate-900">{plan.price}</p>
            <p class="mt-1 text-sm text-slate-500">Typical timeline: {plan.period}</p>
            <ul class="mt-4 space-y-2 border-t border-slate-100 pt-4">
              {plan.items.map((item) => (
                <li class="text-sm text-slate-700">✓ {item}</li>
              ))}
            </ul>
            <p class="mt-4 text-xs text-slate-500">{plan.note}</p>
          </Card>
        ))
      }
    </div>

    <div class="mt-10 rounded-xl border border-slate-200 bg-slate-50 p-6">
      <h2 class="text-lg font-bold text-slate-900">Existing tool upgrades</h2>
      <p class="mt-2 max-w-3xl text-sm text-slate-600">
        We also take on requests like “the macro/script someone built for us stopped working” or
        “we want to add AI to a tool we already have.” We'll review it and quote separately.
      </p>
    </div>
  </Section>
  <Cta locale="en" />
</Base>
