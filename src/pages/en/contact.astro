---
import Breadcrumb from "@/components/Breadcrumb.astro";
import Section from "@/components/ui/Section.astro";
import Base from "@/layouts/Base.astro";
import { GOOGLE_FORM_EMBED_URL_EN, GOOGLE_FORM_URL_EN } from "@/lib/site";
---

<Base
  title="Contact"
  description="Get in touch for a free consultation on automating your team's manual work. It's fine to reach out even at the 'could this work for us?' stage — we reply within 1 business day."
  locale="en"
  alternates={{ ja: "/contact/", en: "/en/contact/" }}
>
  <Breadcrumb items={[{ name: "Contact" }]} locale="en" />
  <Section
    title="Free Consultation"
    lead="It's fine to reach out at the 'could this work for us?' or 'roughly what would this cost?' stage. Tell us about your current manual process and we'll reply within 1 business day."
  >
    <div class="max-w-3xl">
      <div class="overflow-hidden rounded-xl border border-slate-200 bg-white">
        <iframe
          src={GOOGLE_FORM_EMBED_URL_EN}
          title="Free consultation form"
          class="h-[1100px] w-full"
          loading="lazy"
        >
          Loading…
        </iframe>
      </div>
      <p class="mt-4 text-sm text-slate-600">
        If the form doesn't load,{" "}
        <a
          href={GOOGLE_FORM_URL_EN}
          target="_blank"
          rel="noopener noreferrer"
          class="font-bold text-brand-600 underline hover:text-brand-700"
        >
          open it in a new tab
        </a>{" "}
        instead.
      </p>
    </div>
  </Section>
</Base>
