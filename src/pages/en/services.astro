---
import BeforeAfter from "@/components/BeforeAfter.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Cta from "@/components/Cta.astro";
import Card from "@/components/ui/Card.astro";
import Section from "@/components/ui/Section.astro";
import Base from "@/layouts/Base.astro";

/**
 * Service menu (what we sell). Mirrors the Japanese /services/ collection as a digest;
 * individual English service pages are Phase 2 (see docs/i18n-en-plan.md).
 */
const offers = [
  {
    kind: "Start here",
    title: "AI Workflow Assessment",
    price: "$250–450 · 1–2 weeks",
    lead: "Don't buy a system yet. Let us watch your team work for about two hours; you get a report on what can be automated, in what order, and a proposal for one small pilot.",
    href: "/en/pricing/",
  },
  {
    kind: "Start here",
    title: "Small Single-Purpose Tools",
    price: "1–2 weeks",
    lead: "One problem, one screen. PDF diff, FAQ generation, outreach drafting, quote generation, HS code lookup — built for your data and your formats.",
    href: "#tools",
  },
  {
    kind: "Core service",
    title: "Internal Knowledge Search & Inquiry Response AI",
    price: "Assessment → Pilot → Build → Support",
    lead: "Cut the time spent hunting through PDFs, manuals, meeting notes, and past proposals — and the time spent writing replies. Ask a question, get the source, a draft answer, and the next action.",
    href: "#pdf",
  },
  {
    kind: "Core service",
    title: "AI Sales Support System",
    price: "Assessment → Pilot → Build → Support",
    lead: "Account research, per-company outreach drafts, reply triage, follow-ups, CRM entry. Start with just “research 100 accounts and draft an email for each.”",
    href: "#sales",
  },
  {
    kind: "Core service",
    title: "AI Document Workflow Automation",
    price: "Assessment → Pilot → Build → Support",
    lead: "Reports, quotes, applications, meeting minutes. Source material → AI analysis → draft → review → PDF → history. Turn an 8-hour monthly report into a 2-hour one.",
    href: "#excel",
  },
];

const tools = [
  "PDF diff — list the changes between two versions of a contract or spec",
  "FAQ generation — draft an FAQ from your inquiry history",
  "Outreach email drafting — company name + URL in, research summary and email out",
  "Account research — public-information company summaries",
  "CSV analysis — sales or inventory data in, aggregation and commentary out",
  "Quote generation — enter the conditions, get a quote PDF",
  "HS code lookup support — candidate codes with cited grounds from item details",
  "Inventory calculation — reorder points and safety stock",
  "Market and review analysis — classify reviews and summarize the key points",
];

const services = [
  {
    slug: "pdf",
    title: "PDF & Documents",
    lead: "Manuals, policies, specs. Turn “it's in a PDF somewhere” into a few-second lookup.",
    pains: [
      "Policy and manual PDFs are scattered across shared folders, so just finding one is a chore",
      "“We must have handled something similar before” ends up redone from scratch anyway",
      "Only the veteran staff know which document has the answer, and where",
    ],
    before: [
      { step: "Search folders for the likely PDF", minutes: 15 },
      { step: "Open it and hunt for the relevant section", minutes: 20 },
      { step: "Give up and ask someone who knows", minutes: 10 },
    ],
    after: [
      { step: "Ask a question, review the answer and its source", minutes: 3 },
    ],
  },
  {
    slug: "excel",
    title: "Excel & Admin Work",
    lead: "Data entry, aggregation, reconciliation, reports. If you do the same steps every month, it's almost certainly automatable.",
    pains: [
      "Copying data from multiple files into the same sheet every month",
      "Month-end aggregation and reporting eats an entire day",
      "Manually cross-checking two tables by eye, worried about mistakes",
    ],
    before: [
      { step: "Collect and open files from each department", minutes: 20 },
      { step: "Enter and format data into the target sheet", minutes: 60 },
      { step: "Aggregate and build the report", minutes: 40 },
      { step: "Check everything by eye", minutes: 20 },
    ],
    after: [
      { step: "Review the automated output and fix exceptions", minutes: 15 },
    ],
  },
  {
    slug: "mail",
    title: "Email",
    lead: "Inquiries, orders, requests arriving daily. Let AI handle triage and draft replies.",
    pains: [
      "The first-thing-in-the-morning inbox triage alone burns 30 minutes",
      "Writing near-identical replies to similar inquiries from scratch, every time",
      "Manually copying email content into the core system or a spreadsheet",
    ],
    before: [
      { step: "Read inbound email and sort it", minutes: 30 },
      { step: "Draft replies to routine inquiries", minutes: 40 },
      { step: "Log the content into a system or ledger", minutes: 20 },
    ],
    after: [
      {
        step: "Review the AI's classification, draft, and logged entry, then send",
        minutes: 15,
      },
    ],
  },
  {
    slug: "sales",
    title: "Sales",
    lead: "Account research, list building, proposal drafts, CRM entry. Cut prep time to under half.",
    pains: [
      "Building a target list eats most of the sales team's time",
      "Writing proposals and email copy from scratch, every single time",
      "CRM entry after a meeting keeps getting pushed to “later” and piles up",
    ],
    before: [
      {
        step: "Research candidate companies online and take notes",
        minutes: 60,
      },
      { step: "Organize into a prioritized list", minutes: 30 },
      { step: "Write a proposal and email per company", minutes: 45 },
      { step: "Log the activity in the CRM", minutes: 20 },
    ],
    after: [
      {
        step: "Review and adjust the AI-drafted research summary, list, and copy",
        minutes: 40,
      },
    ],
  },
  {
    slug: "backoffice",
    title: "Back Office",
    lead: "Invoices, receipts, purchase orders. Eliminate manual entry from stacks of paper and PDFs with OCR + AI.",
    pains: [
      "Opening every invoice PDF that arrives each month and typing it into accounting software",
      "Every vendor uses a different format, so OCR still means manual correction anyway",
      "Overtime spikes hard right at month-end and month-start",
    ],
    before: [
      { step: "Open each invoice (PDF or paper) and review it", minutes: 30 },
      { step: "Enter it into accounting software or a ledger", minutes: 60 },
      { step: "Manually check amounts and payees", minutes: 30 },
    ],
    after: [
      { step: "Review the AI's extracted results, then import", minutes: 20 },
    ],
  },
  {
    slug: "search",
    title: "Internal AI Search",
    lead: "Eliminate “who do I even ask about this?” with an AI help desk that answers from your own rules, procedures, and precedents.",
    pains: [
      "Admin and IT get the same questions every single day",
      "Only a handful of people can answer, and it keeps eating their time",
      "The manual exists, but nobody reads it or can find the right part",
    ],
    before: [
      { step: "Hunt for who to ask, then ask", minutes: 10 },
      {
        step: "The person interrupts their work to look it up and reply",
        minutes: 15,
      },
    ],
    after: [
      { step: "Ask the AI desk, review the answer and its source", minutes: 2 },
    ],
  },
];
---

<Base
  title="What We Automate"
  description="Five services — AI workflow assessment, small single-purpose tools, internal knowledge search, AI sales support, and document workflow automation — and the six workflows they automate."
  locale="en"
>
  <Breadcrumb items={[{ name: "Services" }]} locale="en" />

  <div class="bg-brand-950 text-white">
    <div class="mx-auto max-w-6xl px-4 py-14 sm:py-20">
      <p class="text-sm font-bold text-brand-300">Services</p>
      <h1 class="mt-2 text-3xl font-bold sm:text-4xl">What We Offer, and What We Automate</h1>
      <p class="mt-4 max-w-2xl text-brand-100">
        We sell outcomes on specific workflows, not “AI development.” Start with a paid
        assessment or one small tool, confirm the impact in numbers, then move to a full build.
      </p>
    </div>
  </div>

  <Section
    title="What we offer"
    lead="Two entry points, three core services. Every service follows the same four steps: assessment → pilot → full build → ongoing support, with each step priced upfront."
  >
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        offers.map((o) => (
          <Card href={o.href} class="flex h-full flex-col">
            <p class="text-xs font-bold text-brand-600">{o.kind}</p>
            <h2 class="mt-1 text-lg font-bold text-slate-900">{o.title}</h2>
            <p class="mt-1 text-xs text-slate-500">{o.price}</p>
            <p class="mt-2 flex-1 text-sm text-slate-600">{o.lead}</p>
            <p class="mt-4 text-sm font-bold text-brand-600">Learn more →</p>
          </Card>
        ))
      }
    </div>
  </Section>

  <div class="border-t border-slate-200 bg-slate-50">
    <div class="mx-auto max-w-6xl px-4 pt-14 sm:pt-20">
      <h2 class="text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">What we automate</h2>
      <p class="mt-3 max-w-3xl text-slate-600">
        The workflows below are what the core services are made of. If any of them sound
        familiar, they're a strong candidate.
      </p>
    </div>
  </div>

  {
    services.map((s, i) => (
      <div id={s.slug} class:list={["scroll-mt-16", i % 2 === 0 && "bg-slate-50"]}>
        <Section title={s.title} lead={s.lead}>
          <ul class="grid gap-3 sm:grid-cols-2">
            {s.pains.map((pain) => (
              <li class="rounded-lg border border-slate-200 bg-white px-4 py-3 text-slate-700">
                {pain}
              </li>
            ))}
          </ul>
          <div class="mt-8">
            <BeforeAfter before={s.before} after={s.after} locale="en" />
          </div>
        </Section>
      </div>
    ))
  }

  <div id="tools" class="scroll-mt-16 bg-brand-50">
    <Section
      title="Small single-purpose tools"
      lead="No need to spend six months on a big system. One problem, one screen, built for your team in 1–2 weeks. Examples of what we can build:"
    >
      <ul class="grid gap-3 sm:grid-cols-2">
        {
          tools.map((t) => (
            <li class="rounded-lg border border-brand-100 bg-white px-4 py-3 text-sm text-slate-700">
              {t}
            </li>
          ))
        }
      </ul>
      <p class="mt-6 text-sm text-slate-600">
        Quoted individually. Tell us the problem in a free consultation and we'll say on the spot
        whether it's a 1–2 week build or something bigger.
      </p>
    </Section>
  </div>

  <Cta locale="en" />
</Base>
