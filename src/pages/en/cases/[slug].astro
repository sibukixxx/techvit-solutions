---
import { getCollection, render } from "astro:content";
import BeforeAfter from "@/components/BeforeAfter.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Cta from "@/components/Cta.astro";
import ModelCaseNote from "@/components/ModelCaseNote.astro";
import Section from "@/components/ui/Section.astro";
import Base from "@/layouts/Base.astro";
import {
  AUTOMATION_LABELS_BY_LOCALE,
  INDUSTRY_LABELS_BY_LOCALE,
} from "@/lib/i18n";

export async function getStaticPaths() {
  const cases = await getCollection(
    "cases",
    (e) => e.data.published && e.id.startsWith("en/"),
  );
  return cases.map((entry) => ({
    params: { slug: entry.id.slice(3) },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const slug = entry.id.slice(3);
const industryLabels = INDUSTRY_LABELS_BY_LOCALE.en;
const automationLabels = AUTOMATION_LABELS_BY_LOCALE.en;
---

<Base
  title={entry.data.title}
  description={`${entry.data.title} — a model case with Before / After time comparisons, the technology behind it, and the build timeline.`}
  locale="en"
  alternates={{ ja: `/cases/${slug}/`, en: `/en/cases/${slug}/` }}
>
  <Breadcrumb
    items={[
      { name: "Case Studies", path: "/en/cases/" },
      { name: entry.data.title },
    ]}
    locale="en"
  />
  <Section>
    <p class="text-sm font-bold text-brand-600">Case Study</p>
    <h1 class="mt-2 max-w-3xl text-2xl font-bold text-slate-900 sm:text-3xl">
      {entry.data.title}
    </h1>
    <div class="mt-4 flex flex-wrap gap-2 text-xs">
      <span class="rounded-full bg-brand-100 px-2.5 py-0.5 font-bold text-brand-800">
        {industryLabels[entry.data.industry]}
      </span>
      {
        entry.data.automation.map((a) => (
          <span class="rounded-full bg-slate-100 px-2.5 py-0.5 text-slate-600">
            {automationLabels[a]}
          </span>
        ))
      }
    </div>

    {
      entry.data.is_model_case && (
        <div class="mt-6">
          <ModelCaseNote locale="en" />
        </div>
      )
    }

    <div class="mt-8">
      <BeforeAfter
        before={entry.data.before}
        after={entry.data.after}
        locale="en"
      />
    </div>

    <article class="prose prose-slate mt-10 max-w-3xl">
      <Content />
    </article>

    <div class="mt-10 grid gap-4 sm:grid-cols-3">
      <div class="rounded-lg border border-slate-200 bg-slate-50 p-4">
        <p class="text-xs font-bold text-slate-500">How it's built</p>
        <ul class="mt-2 space-y-1 text-sm text-slate-700">
          {entry.data.tech.map((t) => <li>· {t}</li>)}
        </ul>
      </div>
      <div class="rounded-lg border border-slate-200 bg-slate-50 p-4">
        <p class="text-xs font-bold text-slate-500">Timeline</p>
        <p class="mt-2 text-sm text-slate-700">{entry.data.period}</p>
      </div>
      {
        entry.data.price_range && (
          <div class="rounded-lg border border-slate-200 bg-slate-50 p-4">
            <p class="text-xs font-bold text-slate-500">Estimated cost</p>
            <p class="mt-2 text-sm text-slate-700">{entry.data.price_range}</p>
          </div>
        )
      }
    </div>
  </Section>
  <Cta locale="en" />
</Base>
