---
import { getCollection } from "astro:content";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Cta from "@/components/Cta.astro";
import ModelCaseNote from "@/components/ModelCaseNote.astro";
import Card from "@/components/ui/Card.astro";
import Section from "@/components/ui/Section.astro";
import Base from "@/layouts/Base.astro";
import {
  AUTOMATION_LABELS_BY_LOCALE,
  INDUSTRY_LABELS_BY_LOCALE,
} from "@/lib/i18n";
import { formatMinutes, reductionRate, savedMinutes } from "@/lib/reduction";

const cases = (
  await getCollection(
    "cases",
    (e) => e.data.published && e.id.startsWith("en/"),
  )
).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const industryLabels = INDUSTRY_LABELS_BY_LOCALE.en;
const automationLabels = AUTOMATION_LABELS_BY_LOCALE.en;
---

<Base
  title="Case Studies"
  description="Model cases showing time saved by automating PDF search, Excel data entry, email handling, and more, presented as Before / After comparisons."
  locale="en"
  alternates={{ ja: "/cases/", en: "/en/cases/" }}
>
  <Breadcrumb items={[{ name: "Case Studies" }]} locale="en" />
  <Section
    title="Model Cases: Time Saved"
    lead="See which tasks get lighter, and by how much, through Before / After comparisons."
  >
    <div class="mb-8">
      <ModelCaseNote locale="en" />
    </div>
    <div class="grid gap-6 lg:grid-cols-3 sm:grid-cols-2">
      {
        cases.map((entry) => {
          const slug = entry.id.slice(3);
          const saved = savedMinutes(entry.data.before, entry.data.after);
          const rate = reductionRate(entry.data.before, entry.data.after);
          return (
            <Card href={`/en/cases/${slug}/`}>
              <div class="flex flex-wrap gap-2 text-xs">
                <span class="rounded-full bg-brand-100 px-2.5 py-0.5 font-bold text-brand-800">
                  {industryLabels[entry.data.industry]}
                </span>
                {entry.data.automation.map((a) => (
                  <span class="rounded-full bg-slate-100 px-2.5 py-0.5 text-slate-600">
                    {automationLabels[a]}
                  </span>
                ))}
              </div>
              <h2 class="mt-3 font-bold text-slate-900">{entry.data.title}</h2>
              <p class="mt-4 text-sm text-slate-600">
                Per run:
                <span class="mx-1 text-2xl font-bold text-brand-700">
                  −{formatMinutes(saved, "en")}
                </span>
                ({rate}% reduction)
              </p>
            </Card>
          );
        })
      }
    </div>
  </Section>
  <Cta locale="en" />
</Base>
