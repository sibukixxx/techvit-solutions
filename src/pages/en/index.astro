---
import { getCollection } from "astro:content";
import Cta from "@/components/Cta.astro";
import Button from "@/components/ui/Button.astro";
import Card from "@/components/ui/Card.astro";
import Section from "@/components/ui/Section.astro";
import Base from "@/layouts/Base.astro";
import { INDUSTRY_LABELS_BY_LOCALE } from "@/lib/i18n";
import { formatMinutes, savedMinutes } from "@/lib/reduction";

const cases = (
  await getCollection(
    "cases",
    (e) => e.data.published && e.id.startsWith("en/"),
  )
)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);

const industryLabels = INDUSTRY_LABELS_BY_LOCALE.en;

const plans = [
  {
    name: "Automation Assessment",
    price: "$250–450",
    body: "We map out your current manual work and put together a report on what can be automated, how much, and for roughly what cost.",
  },
  {
    name: "PoC (Pilot)",
    price: "$850–2,600",
    body: "We pick the one task with the biggest payoff and build a working prototype against your real data to measure the actual time saved.",
  },
  {
    name: "Full Build",
    price: "From $2,600",
    body: "We turn the validated PoC into something your team uses daily, including existing-tool upgrades.",
  },
];

const services = [
  {
    slug: "pdf",
    title: "PDF & Documents",
    lead: "Make manuals and internal documents instantly searchable.",
  },
  {
    slug: "excel",
    title: "Excel & Admin Work",
    lead: "Automate recurring data entry, aggregation, and reconciliation.",
  },
  {
    slug: "mail",
    title: "Email",
    lead: "Classify inbound email and draft replies automatically.",
  },
  {
    slug: "sales",
    title: "Sales",
    lead: "Automate account research, list building, and proposal drafts.",
  },
  {
    slug: "backoffice",
    title: "Back Office",
    lead: "OCR and auto-entry for invoices and receipts.",
  },
  {
    slug: "search",
    title: "Internal AI Search",
    lead: "An AI help desk that answers from your own internal documents.",
  },
];
---

<Base
  locale="en"
  title="AI Automation for Your Manual Work"
  description="TechVit Solutions automates the manual work you repeat every month — PDF search, Excel entry, email handling, invoice processing — with AI. Assessments start at $250; designed and built by the person you talk to."
  alternates={{ ja: "/", en: "/en/" }}
>
  <!-- Hero -->
  <section class="bg-gradient-to-b from-brand-950 to-brand-900 text-white">
    <div class="mx-auto max-w-6xl px-4 py-20 sm:py-28">
      <h1 class="max-w-3xl text-3xl font-bold leading-tight sm:text-5xl sm:leading-tight">
        How many hours does that manual work cost you every month?
      </h1>
      <p class="mt-6 max-w-2xl text-lg text-brand-100">
        PDF search, Excel entry, email handling, invoice processing — we automate the manual
        work you repeat every month with AI. Designed and built by the person you talk to, so
        there's no back-and-forth and no bloated overhead.
      </p>
      <div class="mt-10 flex flex-wrap gap-4">
        <Button href="/en/contact/" size="lg" class="bg-accent-500 text-brand-950 hover:bg-accent-600">
          Book a free consultation
        </Button>
        <Button href="/en/cases/" size="lg" variant="secondary">
          See time-saved case studies
        </Button>
      </div>
    </div>
  </section>

  <!-- 3-step offer -->
  <Section
    title="Start small, expand once you've seen it work"
    lead="We don't recommend jumping straight to a full build. Assessment → Pilot → Full build — each step's price is on the table upfront."
  >
    <div class="grid gap-6 sm:grid-cols-3">
      {
        plans.map((plan, i) => (
          <Card>
            <p class="text-sm font-bold text-brand-600">STEP {i + 1}</p>
            <h3 class="mt-1 text-lg font-bold text-slate-900">{plan.name}</h3>
            <p class="mt-1 text-2xl font-bold text-slate-900">{plan.price}</p>
            <p class="mt-3 text-sm text-slate-600">{plan.body}</p>
          </Card>
        ))
      }
    </div>
    <p class="mt-6 text-sm text-slate-500">
      See <a href="/en/pricing/" class="text-brand-600 underline hover:text-brand-700">Pricing</a> for details.
    </p>
  </Section>

  <!-- Services -->
  <div class="bg-slate-50">
    <Section
      title="What can be automated"
      lead="If you thought &ldquo;wait, we do that every month too&rdquo; — that task is a candidate."
    >
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          services.map((s) => (
            <Card href={`/en/services/#${s.slug}`}>
              <h3 class="text-lg font-bold text-slate-900">{s.title}</h3>
              <p class="mt-2 text-sm text-slate-600">{s.lead}</p>
              <p class="mt-4 text-sm font-bold text-brand-600">Learn more →</p>
            </Card>
          ))
        }
      </div>
    </Section>
  </div>

  <!-- Cases -->
  <Section
    title="Model cases: time saved"
    lead="See the kind of impact to expect through Before / After comparisons. *These are illustrative model cases, not client results."
  >
    <div class="grid gap-6 sm:grid-cols-3">
      {
        cases.map((entry) => {
          const slug = entry.id.slice(3);
          const saved = savedMinutes(entry.data.before, entry.data.after);
          return (
            <Card href={`/en/cases/${slug}/`}>
              <p class="text-xs font-bold text-slate-500">
                {industryLabels[entry.data.industry]}
              </p>
              <h3 class="mt-1 font-bold text-slate-900">{entry.data.title}</h3>
              <p class="mt-3 text-sm text-slate-600">
                Per run
                <span class="ml-1 text-xl font-bold text-brand-700">
                  −{formatMinutes(saved, "en")}
                </span>
              </p>
            </Card>
          );
        })
      }
    </div>
    <div class="mt-8">
      <Button href="/en/cases/" variant="secondary">See all case studies</Button>
    </div>
  </Section>

  <Cta locale="en" />
</Base>
