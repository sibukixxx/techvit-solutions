---
import { getCollection } from "astro:content";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Cta from "@/components/Cta.astro";
import DownloadPdf from "@/components/DownloadPdf.astro";
import PricingLadder from "@/components/PricingLadder.astro";
import ServiceCard from "@/components/ServiceCard.astro";
import Button from "@/components/ui/Button.astro";
import Section from "@/components/ui/Section.astro";
import Base from "@/layouts/Base.astro";
import {
  DOWNLOADS_PATH,
  OVERVIEW_PDF_PATH,
  OVERVIEW_PDF_TITLE,
  pdfFilename,
} from "@/lib/downloads";
import { plans } from "@/lib/plans";
import { getServicesByKind } from "@/lib/services";
import { WEBMCP_BADGE, WEBMCP_HERO, WEBMCP_TITLE } from "@/lib/webmcp";

const { core, entry } = await getServicesByKind();
const automations = (
  await getCollection("automation", (e) => e.data.published)
).sort((a, b) => a.data.order - b.data.order);
const ongoing = plans("ja").find((p) => p.recurring);
---

<Base
  title="サービス一覧"
  description="AI業務診断、社内ナレッジ検索・問い合わせ対応AI、AI営業支援、AIドキュメント業務自動化、小さな業務ツール開発。「御社のこの業務を、これだけ省力化します」の単位でご提案する5つのサービスです。"
>
  <Breadcrumb items={[{ name: "サービス" }]} />

  <div class="bg-brand-950 text-white">
    <div class="mx-auto max-w-6xl px-4 py-14 sm:py-20">
      <p class="text-sm font-bold text-brand-300">サービス</p>
      <h1 class="mt-2 text-3xl font-bold sm:text-4xl">
        「AIを作ります」ではなく、<br class="sm:hidden" />「この業務を、これだけ減らします」
      </h1>
      <p class="mt-4 max-w-2xl text-brand-100">
        技術ではなく、業務の時間で提案します。まずは3〜5万円のAI業務診断か、1〜2週間で作る小さなツール1つから。
        効果を数字で確認してから、主力サービスの本開発に進めます。
      </p>
      <div class="mt-8 flex flex-wrap items-center gap-4">
        <DownloadPdf
          href={OVERVIEW_PDF_PATH}
          filename={pdfFilename(OVERVIEW_PDF_TITLE)}
          variant="light"
          label="サービス総合資料をダウンロード"
        />
        <a href={DOWNLOADS_PATH} class="text-sm text-brand-200 hover:text-white hover:underline">
          サービス別の資料一覧 →
        </a>
      </div>
    </div>
  </div>

  <Section
    title="まず小さく始める"
    lead="いきなり大きな開発は勧めません。どちらも「1つの業務」から始めて、効果を見てから広げるための入口です。"
  >
    <div class="grid gap-6 sm:grid-cols-2">
      {entry.map((s) => <ServiceCard service={s} headingLevel="h2" />)}
    </div>
  </Section>

  <div class="bg-slate-50">
    <Section
      title="業務を変える3つの主力サービス"
      lead="診断で効果が見えた業務を、日常で使える仕組みにします。3つとも、AIが下書き・検索・分類を担当し、最後の確認と判断は人が行う設計です。"
    >
      <div class="grid gap-6 lg:grid-cols-3">
        {core.map((s) => <ServiceCard service={s} headingLevel="h2" />)}
      </div>
    </Section>
  </div>

  <Section
    title="導入後も、設計した本人が運用・改善します"
    lead="どのサービスも、診断 → PoC → 本開発 → 運用・改善の同じ4ステップで進めます。各段階の金額を先に提示し、次に進むかはその都度ご判断ください。"
  >
    <PricingLadder />
    {
      ongoing && (
        <div class="mt-8 rounded-xl border border-brand-200 bg-brand-50 p-6">
          <h3 class="font-bold text-slate-900">{ongoing.name}（{ongoing.price}）に含まれるもの</h3>
          <ul class="mt-3 grid gap-2 text-sm text-slate-700 lg:grid-cols-3">
            {ongoing.items.map((item) => (
              <li>・{item}</li>
            ))}
          </ul>
          <p class="mt-3 text-xs text-slate-500">{ongoing.note}</p>
        </div>
      )
    }
    <div class="mt-8">
      <Button href="/pricing/" variant="secondary">料金の詳細を見る</Button>
    </div>
  </Section>

  <div class="bg-slate-50">
    <Section
      title="「どの業務を」から探す"
      lead="サービスは「何を売るか」の単位、業務自動化は「どの作業が軽くなるか」の単位です。心当たりのある作業から入っても、対応するサービスにたどり着けます。"
    >
      <ul class="flex flex-wrap gap-3">
        {
          automations.map((a) => (
            <li>
              <a
                href={`/automation/${a.id}/`}
                class="inline-block rounded-full border border-slate-200 bg-white px-4 py-2 text-sm font-medium text-slate-700 hover:border-brand-300 hover:text-brand-700"
              >
                {a.data.title}
              </a>
            </li>
          ))
        }
      </ul>
      <div class="mt-6">
        <Button href="/automation/" variant="secondary">業務自動化の一覧へ</Button>
      </div>
    </Section>
  </div>

  <Section
    title="SaaS事業者の方へ：実験的な取り組み"
    lead="ここまでの5サービスとは対象読者・料金体系が異なります。SaaS管理画面の運営者向けの、先行検証サービスです。"
  >
    <div class="rounded-xl border border-slate-200 bg-white p-6">
      <p class="text-xs font-bold text-brand-600">{WEBMCP_BADGE}</p>
      <h3 class="mt-1 text-lg font-bold text-slate-900">{WEBMCP_TITLE}</h3>
      <p class="mt-2 max-w-2xl text-sm text-slate-600">{WEBMCP_HERO.lead}</p>
      <a href="/services/webmcp/" class="mt-4 inline-block text-sm font-bold text-brand-600">
        詳しく見る →
      </a>
    </div>
  </Section>

  <Cta />
</Base>
