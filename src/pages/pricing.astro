---
import Breadcrumb from "@/components/Breadcrumb.astro";
import Cta from "@/components/Cta.astro";
import Card from "@/components/ui/Card.astro";
import Section from "@/components/ui/Section.astro";
import Base from "@/layouts/Base.astro";
import { plans } from "@/lib/plans";

const list = plans("ja");
---

<Base
  title="料金"
  description="AI業務診断3〜5万円、PoC 10〜30万円、本開発30万円〜、運用・改善5〜20万円/月。小さく試して効果を見てから進められる4ステップの料金体系です。小さな業務ツール開発・既存ツールの改修も対応します。"
  alternates={{ ja: "/pricing/", en: "/en/pricing/" }}
>
  <Breadcrumb items={[{ name: "料金" }]} />
  <Section
    title="料金"
    lead="いきなり大きな開発は勧めません。診断 → PoC → 本開発 → 運用・改善の4ステップで、各段階の金額と成果物を先に提示し、次に進むかはその都度ご判断いただけます。どのサービスも同じ進め方です。"
  >
    <div class="grid gap-6 md:grid-cols-2 xl:grid-cols-4">
      {
        list.map((plan) => (
          <Card
            class={plan.recurring ? "border-brand-200 bg-brand-50/40" : ""}
          >
            <p class="text-sm font-bold text-brand-600">{plan.step}</p>
            <h2 class="mt-1 text-xl font-bold text-slate-900">{plan.name}</h2>
            <p class="mt-2 text-3xl font-bold text-slate-900">{plan.price}</p>
            <p class="mt-1 text-sm text-slate-500">期間の目安: {plan.period}</p>
            <ul class="mt-4 space-y-2 border-t border-slate-100 pt-4">
              {plan.items.map((item) => (
                <li class="text-sm text-slate-700">✓ {item}</li>
              ))}
            </ul>
            <p class="mt-4 text-xs text-slate-500">{plan.note}</p>
          </Card>
        ))
      }
    </div>

    <div class="mt-10 grid gap-6 md:grid-cols-2">
      <div class="rounded-xl border border-slate-200 bg-slate-50 p-6">
        <h2 class="text-lg font-bold text-slate-900">小さな業務ツール開発</h2>
        <p class="mt-2 text-sm text-slate-600">
          「1つの問題を1画面で解決する」規模のツールを、1〜2週間で御社用に作ります。
          PDF比較・FAQ生成・営業メール生成・見積書生成など。内容を伺って個別にお見積りします。
        </p>
        <a href="/services/tools/" class="mt-3 inline-block text-sm font-bold text-brand-600 hover:underline">
          作れるものの例を見る →
        </a>
      </div>
      <div class="rounded-xl border border-slate-200 bg-slate-50 p-6">
        <h2 class="text-lg font-bold text-slate-900">既存ツールの改修</h2>
        <p class="mt-2 text-sm text-slate-600">
          「前に作ってもらったマクロ・スクリプトが動かなくなった」「今あるツールにAIを組み込みたい」といったご相談も承ります。内容を拝見して個別にお見積りします。
        </p>
      </div>
    </div>

    <div class="mt-10 max-w-3xl text-sm text-slate-600">
      <h2 class="text-lg font-bold text-slate-900">料金についての考え方</h2>
      <ul class="mt-3 space-y-2">
        <li>・金額は顧客層と案件規模に合わせて調整します。上記は目安です</li>
        <li>・各ステップの前に金額を提示し、途中で止める判断もできます</li>
        <li>・営業・設計・開発・運用を同じ人が担当するため、体制費用が乗りません</li>
      </ul>
    </div>
  </Section>
  <Cta />
</Base>
