---
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import type { Locale } from "@/lib/i18n";
import {
  type Alternates,
  absoluteUrl,
  alternateLinks,
  buildDescription,
  buildTitle,
  organizationJsonLd,
} from "@/lib/seo";
import { SITE_NAME } from "@/lib/site";
import "@/styles/global.css";

interface Props {
  title?: string;
  description?: string;
  ogTitle?: string;
  ogImage?: string;
  /** 追加の JSON-LD（Service など） */
  jsonLd?: Record<string, unknown>[];
  locale?: Locale;
  /** 言語ペアが存在するページのみ指定する（例: { ja: "/pricing/", en: "/en/pricing/" }） */
  alternates?: Alternates;
  /** 隠しページ（検索エンジンに載せない）。sitemap の除外は astro.config.ts 側で行う */
  noindex?: boolean;
}

const {
  title,
  description,
  ogTitle,
  ogImage,
  jsonLd = [],
  locale = "ja",
  alternates,
  noindex = false,
} = Astro.props;

const pageTitle = buildTitle(title);
const pageDescription = buildDescription(description);
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImageUrl = absoluteUrl(ogImage ?? "/og-default.png");
const jsonLdList = [organizationJsonLd(), ...jsonLd];
const ogLocale = locale === "en" ? "en_US" : "ja_JP";
const alternateHreflangs = alternates ? alternateLinks(alternates) : [];
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta
      name="robots"
      content={noindex ? "noindex, nofollow" : "index, follow"}
    />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {
      alternateHreflangs.map((l) => (
        <link rel="alternate" hreflang={l.hreflang} href={l.href} />
      ))
    }

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={ogTitle ?? pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={ogLocale} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle ?? pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImageUrl} />

    {
      jsonLdList.map((schema) => (
        <script
          is:inline
          type="application/ld+json"
          set:html={JSON.stringify(schema)}
        />
      ))
    }
  </head>
  <body class="flex min-h-screen flex-col">
    <Header locale={locale} />
    <main class="flex-1">
      <slot />
    </main>
    <Footer locale={locale} />
  </body>
</html>
