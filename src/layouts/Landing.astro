---
import Base from "@/layouts/Base.astro";
import type { Locale } from "@/lib/i18n";
import { type Alternates, serviceJsonLd } from "@/lib/seo";

interface Props {
  title: string;
  description: string;
  ogTitle?: string;
  ogImage?: string;
  locale?: Locale;
  alternates?: Alternates;
  /** Service JSON-LD に加えて出力する JSON-LD（FAQ など） */
  jsonLd?: Record<string, unknown>[];
}

const {
  title,
  description,
  ogTitle,
  ogImage,
  locale,
  alternates,
  jsonLd: extraJsonLd = [],
} = Astro.props;
const jsonLd = [serviceJsonLd({ name: title, description }), ...extraJsonLd];
---

<Base
  title={title}
  description={description}
  ogTitle={ogTitle}
  ogImage={ogImage}
  jsonLd={jsonLd}
  locale={locale}
  alternates={alternates}
>
  <slot />
</Base>
