---
import Button from "@/components/ui/Button.astro";
import { type Locale, t } from "@/lib/i18n";

interface Props {
  title?: string;
  lead?: string;
  locale?: Locale;
}

const { title, lead, locale = "ja" } = Astro.props;
const dict = t(locale);
const resolvedTitle = title ?? dict.ctaTitle;
const resolvedLead = lead ?? dict.ctaLead;
const contactHref = locale === "en" ? "/en/contact/" : "/contact/";
---

<section class="bg-brand-900">
  <div class="mx-auto max-w-6xl px-4 py-14 text-center sm:py-16">
    <h2 class="text-2xl font-bold text-white sm:text-3xl">{resolvedTitle}</h2>
    <p class="mx-auto mt-4 max-w-2xl text-brand-100">{resolvedLead}</p>
    <div class="mt-8">
      <Button href={contactHref} size="lg" class="bg-accent-500 hover:bg-accent-600 text-brand-950">
        {dict.ctaButton}
      </Button>
    </div>
  </div>
</section>
