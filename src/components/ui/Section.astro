---
interface Props {
  title?: string;
  lead?: string;
  class?: string;
}

const { title, lead, class: className = "" } = Astro.props;
---

<section class:list={["mx-auto max-w-6xl px-4 py-14 sm:py-20", className]}>
  {
    title && (
      <h2 class="text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">
        {title}
      </h2>
    )
  }
  {lead && <p class="mt-3 max-w-3xl text-slate-600">{lead}</p>}
  <div class:list={[title ? "mt-8" : ""]}>
    <slot />
  </div>
</section>
