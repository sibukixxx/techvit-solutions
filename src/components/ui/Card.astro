---
interface Props {
  href?: string;
  class?: string;
}

const { href, class: className = "" } = Astro.props;
const Tag = href ? "a" : "div";
---

<Tag
  href={href}
  class:list={[
    "block rounded-xl border border-slate-200 bg-white p-6 shadow-sm",
    href && "transition hover:border-brand-300 hover:shadow-md",
    className,
  ]}
>
  <slot />
</Tag>
