---
import { type Locale, NAV_ITEMS_BY_LOCALE, t } from "@/lib/i18n";
import { SITE_NAME } from "@/lib/site";

interface Props {
  locale?: Locale;
}

const { locale = "ja" } = Astro.props;
const dict = t(locale);
const navItems = NAV_ITEMS_BY_LOCALE[locale];
const contactHref = locale === "en" ? "/en/contact/" : "/contact/";
const year = new Date().getFullYear();
---

<footer class="border-t border-slate-200 bg-slate-50">
  <div class="mx-auto max-w-6xl px-4 py-10">
    <div class="flex flex-col gap-6 sm:flex-row sm:items-start sm:justify-between">
      <div>
        <p class="flex items-center gap-2 text-base font-bold text-brand-900">
          <img
            src="/logo-mark.png"
            alt=""
            width="24"
            height="24"
            class="size-6"
            loading="lazy"
          />
          {SITE_NAME}
        </p>
        <p class="mt-2 max-w-sm text-sm text-slate-600">
          {dict.footerTagline}
        </p>
      </div>
      <nav class="grid grid-cols-2 gap-x-8 gap-y-2 text-sm">
        {
          [...navItems, { href: contactHref, label: dict.consultCta }].map(
            (item) => (
              <a
                href={item.href}
                class="text-slate-600 hover:text-slate-900 hover:underline"
              >
                {item.label}
              </a>
            ),
          )
        }
      </nav>
    </div>
    <p class="mt-8 text-xs text-slate-400">
      © {year} {SITE_NAME}
    </p>
  </div>
</footer>
